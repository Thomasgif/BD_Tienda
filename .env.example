# ========================================================
# CONFIGURACIÓN DE CONEXIÓN A SUPABASE (POSTGRESQL)
# ========================================================

# Opción 1: Connection URI completa (Recomendado)
# Puedes obtenerla en Supabase -> Project Settings -> Database -> Connection string -> URI / Transaction Pooler (puerto 6543 o 5432)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opción 2: Parámetros individuales (se usan si DATABASE_URL no está definida)
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.yourprojectref
SUPABASE_DB_PASSWORD=your_password_here

# Configuración del Pool de Conexiones
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=10
